rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Users Collection
    match /users/{userId} {
      allow read, write: if isValidId(userId);
    }

    // Areas Collection
    match /areas/{areaId} {
      allow read, write: if isValidId(areaId);
    }

    // Assets Collection
    match /assets/{assetId} {
      allow read, write: if isValidId(assetId);
    }

    // Transfers Collection
    match /transfers/{transferId} {
      allow read, write: if isValidId(transferId);
    }

    // Disposals Collection
    match /disposals/{disposalId} {
      allow read, write: if isValidId(disposalId);
    }

    // Settings Collection
    match /settings/{settingId} {
      allow read, write: if isValidId(settingId);
    }

    // Connection testing
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
